DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_NAME=
DB_PORT=1433
DB_KEEPALIVE_DISABLED=false
JWT_SECRET=
JWT_ISSUER=wolfbox-api
JWT_AUDIENCE=wolfbox-web
NODE_ENV=development
# Usa "none" solamente si frontend y API de staging están en dominios de sitios diferentes.
REFRESH_COOKIE_SAME_SITE=lax
PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Redis distribuido para rate limiting. Railway puede inyectarlo como referencia al servicio Redis.
REDIS_URL=
RATE_LIMIT_API_5M=600
RATE_LIMIT_LOGIN_15M=10
RATE_LIMIT_REFRESH_15M=120
RATE_LIMIT_PASSWORD_RESET_1H=5
RATE_LIMIT_REGISTRO_1H=15
RATE_LIMIT_TRACKING_15M=30
RATE_LIMIT_BUSQUEDA_5M=120
RATE_LIMIT_REPORTES_10M=20
RATE_LIMIT_PDF_10M=30
RATE_LIMIT_HEALTH_DB_1M=10

# Brevo transactional email API
BREVO_API_KEY=
BREVO_DEFAULT_SENDER_EMAIL=info@jaescargo.com
BREVO_DEFAULT_SENDER_NAME=Jaes Cargo Internacional
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_MINUTES=60
